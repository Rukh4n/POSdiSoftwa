<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030303"
    tools:context=".InfoFragment">

    <TextView
        android:id="@+id/titleSetelan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Setelan"
        android:textColor="#F1EFEC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="start"
        android:padding="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/containerButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleSetelan">

        <Button
            android:id="@+id/btnConnectPrinter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hubungkan Printer"
            android:textColor="#030303"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#F1EFEC"
            android:layout_marginBottom="12dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnBackupData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backup Data Toko"
            android:textColor="#030303"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#F1EFEC"
            android:layout_marginBottom="12dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnImportProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Data Toko"
            android:textColor="#030303"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#F1EFEC"
            android:padding="12dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/instagramLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/border_orange"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/instagram"
                app:tint="#F1EFEC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@nur_rukhan"
                android:textColor="#F1EFEC"
                android:textSize="16sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiktokLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/border_orange"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/tiktok"
                app:tint="#F1EFEC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@nur_rukhan"
                android:textColor="#F1EFEC"
                android:textSize="16sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>