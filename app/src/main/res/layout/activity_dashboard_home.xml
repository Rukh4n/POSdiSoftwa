<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#030303"
    tools:context=".DashboardHomeFragment">

    <!-- Dashboard Header (tidak ikut scroll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/border_orange"
        android:padding="8dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvDashboardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="#F1EFEC"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Konten dapat discroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- Total Pendapatan Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#D4C9BE"
                android:layout_marginBottom="8dp"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTotalPendapatan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#030303"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="27sp"
                    android:autoSizeStepGranularity="2sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Pendapatan"
                    android:textColor="#030303"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Products and Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/border_orange"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvJumlahProduk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#F1EFEC"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="27sp"
                        android:autoSizeStepGranularity="2sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Produk"
                        android:textColor="#F1EFEC"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/border_orange"
                    android:layout_marginStart="8dp"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvJumlahKategori"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#F1EFEC"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="27sp"
                        android:autoSizeStepGranularity="2sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kategori"
                        android:textColor="#F1EFEC"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Total Harga Beli -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/border_orange"
                android:layout_marginBottom="16dp"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTotalHargaBeli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F1EFEC"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="27sp"
                    android:autoSizeStepGranularity="2sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aset Produk"
                    android:textColor="#F1EFEC"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Total Proyeksi Pendapatan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/border_orange"
                android:layout_marginBottom="16dp"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTotalProyeksiPendapatan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F1EFEC"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="27sp"
                    android:autoSizeStepGranularity="2sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proyeksi Pendapatan"
                    android:textColor="#F1EFEC"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Potensi Keuntungan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/border_orange"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvPotensiKeuntungan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F1EFEC"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="27sp"
                    android:autoSizeStepGranularity="2sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proyeksi Keuntungan"
                    android:textColor="#F1EFEC"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
